{
  "name": "beit-midrash-seating-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute beit-midrash-seating --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute beit-midrash-seating --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
